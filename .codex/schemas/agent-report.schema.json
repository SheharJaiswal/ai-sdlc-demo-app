{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/agent-report.schema.json",
  "title": "AI SDLC Agent Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "report_id", "session_id", "agent", "status", "summary", "evidence", "findings", "risks", "decisions_needed", "validation", "payload", "generated_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "report_type": { "enum": ["business_analysis", "architecture", "developer_handoff", "qa", "security", "code_review"] },
    "report_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "status": { "enum": ["complete", "blocked", "needs_decision"] },
    "summary": { "type": "string" },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "decisions_needed": { "type": "array", "items": { "type": "string" } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands_executed", "commands_not_run"],
      "properties": {
        "commands_executed": { "type": "array", "items": { "type": "string" } },
        "commands_not_run": { "type": "array", "items": { "type": "string" } }
      }
    },
    "payload": { "type": "object" },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "result"],
      "properties": {
        "kind": { "enum": ["file", "command", "test", "document", "diff"] },
        "reference": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "fail", "not_run", "observed"] }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "summary", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "recommendation": { "type": "string" }
      }
    }
  }
}
